# ==============================================================================
# Comprehensive & Secure .gitignore — Karka AI & Tech Academy
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
tools/site-audit/node_modules/

# Next.js & Turbopack Build Artifacts
/.next/
/out/
/build/
/dist/

# Environment Variables & Secrets (Prevent accidental secret leaks)
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.local
!.env.example

# Testing, E2E & Code Coverage
/coverage
/playwright-report
/test-results
/.nyc_output

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Debug & Execution Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Operating System Cache & Thumbnails
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Deployment Caches
.vercel

# Audit Raw Crawls & Scratch
docs/site-audit/
scratch/
