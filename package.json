{
  "name": "karka-academy",
  "version": "1.0.0",
  "private": true,
  "description": "Redesigned website for Karka AI & Tech Academy (Nagercoil, Tamil Nadu)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contrast": "tsx scripts/check-contrast.ts",
    "test:sec": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y",
    "lighthouse": "lhci autorun",
    "verify:content": "tsx scripts/verify-content.ts",
    "verify:originality": "tsx scripts/check-originality.ts",
    "verify:all": "npm run typecheck && npm run lint && npm run test:contrast && npm run verify:content && npm run verify:originality && npm run test && npm run test:sec && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@upstash/ratelimit": "^2.0.5",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.1",
    "three": "^0.174.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.10.2",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
